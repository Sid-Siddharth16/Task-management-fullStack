NODE_ENV=development
PORT=8000
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
CORS_ORIGIN=http://localhost:5173
# optional
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
APP_URL=http://localhost:5173

# mail — required in production; in development reset links are logged to the console when SMTP_HOST is empty
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TaskFlow <no-reply@example.com>"

# used only by `npm run seed:admin`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@app.com
ADMIN_PASSWORD=Admin@123
